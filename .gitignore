# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
.venv-bora/
venv/
env/
.conda/

# Private, machine-specific HPC glue (cluster login / queue / module details
# that do not belong in the public repo). Lives in the working tree, never
# committed. See hpc-local/README.md.
/hpc-local/

# Testing and tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Environment variables
.env
.env.local

# macOS
.DS_Store

# VS Code (personal, not shared)
.vscode/launch.json
.vscode/tasks.json
# Note: .vscode/settings.json IS committed (project config)

# LaTeX build artifacts (the .tex and .pdf in docs/ are committed)
*.aux
*.fdb_latexmk
*.fls
*.synctex.gz
docs/*.log
docs/*.out
docs/*.toc

# Sweep / study output (regenerated by running simulations)
*.parquet
*.tableaux.h5
*.tableaux.npz

# intermediate benchmark data (figures are committed; scripts regenerate it)
docs/figures/runtime_data.json

# Study/sweep output directories (the README and notebooks write here)
runs/
