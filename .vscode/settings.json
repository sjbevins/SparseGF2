{
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
    "python.terminal.activateEnvironment": true,
    "python.analysis.extraPaths": ["src"],
    "python.testing.pytestEnabled": true,
    "python.testing.pytestArgs": ["tests"],
    "latex-workshop.latex.autoBuild.run": "never",
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
        }
    },
    "files.exclude": {
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/.ruff_cache": true,
        "**/*.egg-info": true,
        "**/truedist": true,
        "**/truedist_long": true,
        "**/truedist256": true,
        "**/dcont": true,
        "**/genweights": true,
        "**/expurgate": true,
        "**/expurgate_study": true,
        "**/expurgate_certified": true,
        "**/gen_weights_ckpts": true,
        "**/imi_variance_data": true,
        "**/imi_freq_data": true,
        "**/tmi_pc/data": true,
        "**/tmi_pc/data_z": true,
        "**/tmi_pc/crossover_analysis/data_tmi": true,
        "**/tmi_pc/crossover_analysis/data_growth_pc": true,
        "**/prl_production/data": true,
        "**/prl_production/logs": true,
        "**/prl_production/manifests/runtime": true,
        "**/imi": true,
        "**/tab": true
    },
    "files.watcherExclude": {
        "**/.git/**": true,
        "**/truedist/**": true,
        "**/truedist_long/**": true,
        "**/truedist256/**": true,
        "**/dcont/**": true,
        "**/genweights/**": true,
        "**/expurgate/**": true,
        "**/expurgate_study/**": true,
        "**/expurgate_certified/**": true,
        "**/gen_weights_ckpts/**": true,
        "**/data_n*/**": true,
        "**/tmi_pc/data/**": true,
        "**/tmi_pc/data_z/**": true,
        "**/tmi_pc/crossover_analysis/data_tmi/**": true,
        "**/tmi_pc/crossover_analysis/data_growth_pc/**": true,
        "**/prl_production/data/**": true,
        "**/prl_production/logs/**": true,
        "**/prl_production/manifests/runtime/**": true,
        "**/figs*/**": true,
        "**/runs/**": true,
        "**/imi/**": true,
        "**/tab/**": true,
        "**/figures_export/**": true,
        "**/*.npz": true
    },
    "search.exclude": {
        "**/truedist/**": true,
        "**/truedist_long/**": true,
        "**/truedist256/**": true,
        "**/dcont/**": true,
        "**/genweights/**": true,
        "**/expurgate*/**": true,
        "**/gen_weights_ckpts/**": true,
        "**/data_n*/**": true,
        "**/tmi_pc/data/**": true,
        "**/tmi_pc/data_z/**": true,
        "**/tmi_pc/crossover_analysis/data_tmi/**": true,
        "**/tmi_pc/crossover_analysis/data_growth_pc/**": true,
        "**/prl_production/data/**": true,
        "**/prl_production/logs/**": true,
        "**/prl_production/manifests/runtime/**": true,
        "**/figs*/**": true,
        "**/figures_export/**": true
    }
}
